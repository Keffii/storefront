# Copy to .env.local for local development. Everything is optional: without
# Stripe keys and an Amplify backend the shop still runs, and checkout,
# accounts, reviews and admin explain that they aren't configured.

# Stripe test-mode keys (Dashboard → Developers → API keys). Live keys are
# refused. Leave these commented out until you have real test keys: a
# placeholder value counts as a key and makes checkout fail.
# STRIPE_SECRET_KEY=sk_test_...
# Signing secret of the webhook endpoint /api/stripe/webhook.
# STRIPE_WEBHOOK_SECRET=whsec_...

# Public base URL, used for canonical links, the sitemap and Open Graph images.
SITE_URL=http://localhost:3000

# Salt for hashing IP addresses in rate limits.
HASH_SALT=change-me

# Public source link on /om-projektet.
# NEXT_PUBLIC_REPO_URL=https://github.com/Keffii/storefront

# Normally read from amplify_outputs.json; set these to point a local
# server at an existing table instead. The region defaults to eu-north-1.
# STOREFRONT_TABLE=
# STOREFRONT_REGION=
